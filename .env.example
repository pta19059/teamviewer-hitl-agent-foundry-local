# Model provider: foundry_local or foundry_cloud
MODEL_PROVIDER=foundry_local

# Foundry Local model alias. The model must support function/tool calling.
FOUNDRY_LOCAL_MODEL=phi-4-mini
# Optional override. Leave blank to discover it with `foundry server status -o json`.
FOUNDRY_LOCAL_ENDPOINT=

# Cloud Microsoft Foundry settings (used only when MODEL_PROVIDER=foundry_cloud)
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=gpt-5.4-mini

# local: spawn the official TeamViewer MCP server over stdio
# http: connect to a self-hosted TeamViewer MCP server over Streamable HTTP
TEAMVIEWER_MCP_TRANSPORT=local

# Local transport settings
TEAMVIEWER_MCP_COMMAND=node
TEAMVIEWER_MCP_SCRIPT=external/TV_Remote_MCP/dist/index.js
TEAMVIEWER_API_TOKEN=

# HTTP transport settings (used only when TEAMVIEWER_MCP_TRANSPORT=http)
TEAMVIEWER_MCP_URL=http://localhost:3000/mcp
TEAMVIEWER_MCP_BEARER_TOKEN=

# Included in the local approval audit trail
OPERATOR_ID=your.name@company.example
